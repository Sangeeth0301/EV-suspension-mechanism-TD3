flowchart LR
    %% External Inputs (Disturbances)
    D1(("🛣️ Road Profile w(t)"))
    D2(("⚡ IWM Disturbance F_em(t)"))
    
    %% 1. Intelligence (Controller Block)
    subgraph CONTROL["🧠 AI & CONTROL (ECU)"]
        direction TB
        UKF["Unscented Kalman Filter<br/>(Estimates ρ, ρ̇)"]
        TD3["TD3 DRL Agent<br/>(Energy Supervisor)"]
        LPV["LPV H∞ Controller<br/>(Computes optimal Force)"]
        
        UKF -->|"ρ, ρ̇"| LPV
        UKF -->|"ρ, ρ̇"| TD3
        TD3 -->|"COMFORT / ECO Mode"| LPV
    end
    
    %% 2. Actuation Block
    subgraph ACTUATION["⚙️ ACTUATOR"]
        ACT["Bidirectional EM Actuator"]
    end
    
    %% 3. The Physical Plant (System being controlled)
    subgraph PLANT["🔧 PHYSICAL VEHICLE"]
        CAR["4-DOF Half-Car Dynamics"]
    end
    
    %% 4. The Feedback Loop (Sensors & Security)
    subgraph SENSORS["📡 CYBER DEFENSE & SENSORS"]
        direction RL
        EDGEML["Edge ML Detector<br/>(Blocks DoS/FDI)"]
        METS["METS Filter<br/>(Reduces Network Load)"]
        EDGEML --> METS
    end
    
    %% 5. Energy Harvesting Branch
    subgraph POWER["⚡ POWER ELECTRONICS"]
        direction LR
        LC["LC Low-Pass Filter<br/>(AC to DC)"]
        BATT["Main EV Battery"]
        LC -->|"DC Charge"| BATT
    end

    %% --- THE ROUTING (FORWARD & FEEDBACK PATHS) ---

    %% Disturbances hit the car
    D1 --> CAR
    D2 --> CAR
    
    %% Control Signal hits Actuator, Actuator pushes Car
    LPV -->|"Command Force u(t)"| ACT
    ACT <-->|"Applied Force / Kinematics"| CAR
    
    %% Energy Harvesting Path (Diverts from Actuator)
    ACT ===>|"Harvested AC Voltage"| LC
    BATT -.->|"State of Charge (SoC)"| TD3
    
    %% THE FEEDBACK LOOP (Bottom Path)
    CAR ===>|"Raw Sensor Data x(t)"| EDGEML
    METS ===>|"Clean Sensor Data x(t)"| UKF
    METS --->|"Clean Sensor Data x(t)"| LPV

    %% Styling for professional look
    style CONTROL fill:#0f172a,stroke:#8b5cf6,color:#f8fafc,stroke-width:2px
    style ACTUATION fill:#0f172a,stroke:#3b82f6,color:#f8fafc,stroke-width:2px
    style PLANT fill:#1e293b,stroke:#3b82f6,color:#f8fafc,stroke-width:2px
    style SENSORS fill:#0f172a,stroke:#ef4444,color:#f8fafc,stroke-width:2px
    style POWER fill:#0f172a,stroke:#10b981,color:#f8fafc,stroke-width:2px
    style D1 fill:#1e293b,stroke:#94a3b8,color:#f8fafc
    style D2 fill:#1e293b,stroke:#94a3b8,color:#f8fafc
